#!/bin/bash
# Wrapper script for mcp-server-macos-use
# Runs the Swift binary built by `swift build -c release`, caching the compiled binary across npx invocations

set -euo pipefail

# Resolve symlinks to find the real script location
SOURCE="$0"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
PKG_DIR="$(dirname "$SCRIPT_DIR")"

BINARY="$PKG_DIR/.build/release/mcp-server-macos-use"
if [ -x "$BINARY" ]; then
  exec "$BINARY" "$@"
fi

VERSION="$(node -p "try { require('$PKG_DIR/package.json').version } catch { 'unknown' }" 2>/dev/null || echo "unknown")"
ARCH="$(uname -m)"
CACHE_ROOT="${XDG_CACHE_HOME:-$HOME/.cache}/mcp-server-macos-use/${VERSION}-${ARCH}"
CACHED_BINARY="$CACHE_ROOT/mcp-server-macos-use"

if [ -x "$CACHED_BINARY" ]; then
  exec "$CACHED_BINARY" "$@"
fi

mkdir -p "$CACHE_ROOT"
LOCK_DIR="$CACHE_ROOT/.build.lock"
while ! mkdir "$LOCK_DIR" 2>/dev/null; do
  if [ -x "$CACHED_BINARY" ]; then
    exec "$CACHED_BINARY" "$@"
  fi
  sleep 0.2
done
trap 'rmdir "$LOCK_DIR" 2>/dev/null || true' EXIT

if [ ! -x "$CACHED_BINARY" ]; then
  echo "Building mcp-server-macos-use ($VERSION)..." >&2
  (cd "$PKG_DIR" && swift build -c release >&2)
  cp "$BINARY" "$CACHED_BINARY.tmp.$$"
  chmod +x "$CACHED_BINARY.tmp.$$"
  mv "$CACHED_BINARY.tmp.$$" "$CACHED_BINARY"
fi

rmdir "$LOCK_DIR" 2>/dev/null || true
trap - EXIT
exec "$CACHED_BINARY" "$@"
